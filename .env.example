# =============================================================================
# ATNN Quant Powerhouse — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =============================================================================

# --- Alpaca Brokerage ---
# Get keys from https://app.alpaca.markets/
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# --- System ---
SYSTEM_MODE=paper          # backtest | paper | live
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
PORTFOLIO_VALUE=100000     # Initial portfolio value in USD
TIMEZONE=America/New_York

# --- Data ---
DATA_PROVIDER=alpaca       # alpaca | yfinance
HISTORY_DAYS=756           # ~3 trading years of history
DATA_CACHE_DIR=data/cache

# --- Backtest ---
BACKTEST_SLIPPAGE_BPS=7
BACKTEST_COMMISSION_PER_SHARE=0.005
BACKTEST_TRAIN_WINDOW=504
BACKTEST_TEST_WINDOW=21
BACKTEST_STEP_SIZE=21

# --- Risk ---
RISK_MAX_POSITION_PCT=0.20
RISK_MAX_SECTOR_PCT=0.35
RISK_MAX_DRAWDOWN_HALT=-0.30
RISK_MAX_DRAWDOWN_REDUCE=-0.20
RISK_DAILY_LOSS_LIMIT=-0.03
RISK_MAX_CORRELATION=0.85
RISK_MAX_SHORT_EXPOSURE=0.20

# --- ML ---
ML_FEATURE_LOOKBACK=252
ML_RETRAIN_FREQ_DAYS=7
ML_MODEL_DIR=models/lgbm
