# =============================================================================
# Alpaca Paper Trading API — REQUIRED (if BROKER=alpaca)
# Get keys at https://app.alpaca.markets/paper/dashboard/overview
# =============================================================================
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true

# Legacy env var names (both conventions are supported)
APCA_API_KEY_ID=your_alpaca_key_here
APCA_API_SECRET_KEY=your_alpaca_secret_here
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# =============================================================================
# Interactive Brokers (IB Gateway / TWS) — REQUIRED (if BROKER=ibkr)
# =============================================================================
BROKER=ibkr
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_ACCOUNT=U22452226
IBKR_PAPER_MODE=true

# IB Gateway Docker container credentials (used by deploy/ib_gateway_docker.sh)
TWS_USERID=your_tws_username_here
TWS_PASSWORD=your_tws_password_here
TRADING_MODE=paper

# =============================================================================
# Discord Bot — OPTIONAL (for alerts and monitoring)
# =============================================================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# =============================================================================
# Portfolio settings
# =============================================================================
PORTFOLIO_VALUE=100000
PAPER_TRADING=true

# Azure Text-to-Speech (Optional)
# AZURE_TTS_KEY=your_azure_tts_key_here
# AZURE_TTS_REGION=eastus
