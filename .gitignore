# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment
.env
.env.local

# Live credentials / runtime secrets (NEVER commit) — only the *.example template
# is tracked. The droplet writes the real etf-engine.env inside the repo dir.
etf-engine.env
vrp-engine.env
*.env
!*.env.example
# IBC renders this from the template with real credentials at service start.
config.runtime.ini

# Logs (keep structure, ignore contents)
logs/*.jsonl
logs/*.log

# Model artifacts (large binaries)
models/**/*.pkl
models/**/*.joblib

# OS
.DS_Store
Thumbs.db

# Data cache
data/cache/
*.parquet
*.h5

# ETF engine runtime state / telemetry / cache (machine-local; never commit)
.etf_telemetry/
.etf_cache/

# Backtest result snapshots
backtest_results*.json

# pytest cache
.pytest_cache/
