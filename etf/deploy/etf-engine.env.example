# ETF Tactical-Allocation Engine — environment template.
# Copy to /root/etf-engine/etf-engine.env and edit. Referenced by the systemd
# unit via EnvironmentFile. The config (etf/config.py) reads these at startup.

# --- IBKR connection ---------------------------------------------------------
# Gateway/TWS host. 127.0.0.1 if the Gateway runs on the same machine.
IBKR_HOST=127.0.0.1

# Port: 4002 = IB Gateway PAPER, 4001 = IB Gateway LIVE,
#       7497 = TWS PAPER,        7496 = TWS LIVE.
IBKR_PORT=4002

# IBKR account id (e.g. paper "DU1234567"). Leave blank to use the only account
# the connection exposes.
IBKR_ACCOUNT=

# Client id MUST differ from the VRP engine (which uses a different id) so both
# can connect to the same Gateway concurrently. Default 7.
ETF_IBKR_CLIENT_ID=7

# Market-data type for live quotes:
#   1 = real-time (needs a paid subscription), 2 = frozen,
#   3 = delayed (free, ~15-min lag, DEFAULT), 4 = delayed-frozen.
# A fresh paper account usually has NO real-time data, so keep 3 until you add
# a market-data subscription in Account Management.
IBKR_MARKET_DATA_TYPE=3

# --- IB Gateway auto-login (IBC) — used by ibc-gateway.service ----------------
# Your IBKR login (the same username/password you use for the paper account).
# This file MUST be chmod 600 and root-owned; it is NEVER committed to git.
IBKR_USERNAME=
IBKR_PASSWORD=

# 'paper' or 'live'. KEEP THIS 'paper'. The launcher refuses to auto-start live.
IBKR_TRADING_MODE=paper

# Daily soft-restart time (machine-local = America/New_York after setup). Pick a
# quiet pre-market time; the restart keeps the API session without re-auth.
IBC_RESTART_TIME=07:00 AM

# IB Gateway major version, derived from the installed version directory
# (e.g. /root/Jts/ibgateway/10.30 -> 1030). install-ibgateway.sh prints this.
TWS_MAJOR_VRSN=1030

# --- Alerting (etf-alert.sh / etf-healthcheck) -------------------------------
# OPTIONAL. If set, operational alerts (engine entered FAILED state, Gateway or
# engine not 'active') are POSTed as JSON {"text": "..."} to this URL so you get
# a phone push. Works with Slack/Discord(+/slack)/ntfy/healthchecks.io/custom.
# Leave blank to log alerts locally only (.etf_telemetry/ALERTS.log + journal).
ETF_ALERT_WEBHOOK=


